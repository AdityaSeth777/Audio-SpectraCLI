# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAID_PLAN_PRICE_ID=
# Optional: name of a Stripe Billing Meter event to report Data/Analysis API
# usage against for metered billing. Usage is always recorded in the
# api_usage_events table regardless of whether this is set.
STRIPE_API_USAGE_METER_EVENT_NAME=

# Database (Neon Postgres, used via drizzle-orm/neon-http)
DATABASE_URL=

# Optional: Upstash Redis, for a multi-instance-safe Analysis API rate
# limiter. Without these, rate limiting falls back to an in-memory
# single-process limiter (fine for local dev, not correct once deployed
# across multiple serverless instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
