{
  "name": "audio-spectracli-extension",
  "displayName": "Audio-SpectraCLI Extension",
  "description": "VS Code extension for integrating Audio-SpectraCLI.",
  "version": "4.1.0",
  "publisher": "AdityaSeth777",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdityaSeth777/Audio-SpectraCLI.git"
  },
  "icon": "assets/logo.jpeg",
  "engines": {
    "vscode": "^1.70.0"
  },
  "activationEvents": [
    "onCommand:extension.addSpectraCode",
    "onCommand:extension.viewSpectraCLIStatus",
    "onCommand:extension.startLiveVisualization",
    "onCommand:extension.stopLiveVisualization"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.addSpectraCode",
        "title": "Add Audio-SpectraCLI Code"
      },
      {
        "command": "extension.viewSpectraCLIStatus",
        "title": "View Audio-SpectraCLI Status"
      },
      {
        "command": "extension.startLiveVisualization",
        "title": "Audio-SpectraCLI: Start Live Visualization"
      },
      {
        "command": "extension.stopLiveVisualization",
        "title": "Audio-SpectraCLI: Stop Live Visualization"
      }
    ],
    "configuration": {
      "title": "Audio-SpectraCLI",
      "properties": {
        "audioSpectraCli.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python executable used to run the headless Audio-SpectraCLI streamer (must have Audio_SpectraCLI installed)."
        },
        "audioSpectraCli.sampleRate": {
          "type": "number",
          "default": 44100,
          "description": "Sampling rate (Hz) for the live visualizer."
        },
        "audioSpectraCli.blockSize": {
          "type": "number",
          "default": 4096,
          "description": "FFT block size for the live visualizer."
        },
        "audioSpectraCli.bars": {
          "type": "number",
          "default": 64,
          "description": "Number of bars to render in the live visualizer."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test:unit": "node --test dist/lineParser.test.js",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.7.9",
    "@types/vscode": "^1.70.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^4.0.0"
  }
}
